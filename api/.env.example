# Copy to api/.env and fill in. api/.env is gitignored: never commit real values.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<database>
# Any long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Only needed for photo uploads to S3
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
